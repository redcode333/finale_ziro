SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Set to any long random string to enable POST /teams/{id}/seed (sent as X-Admin-Token)
SEED_ADMIN_TOKEN=

# Cloudflare Turnstile (human verification on mentor sign-in). Leave TURNSTILE_ENABLED=false for local development.
# When true, TURNSTILE_SECRET_KEY is required and verification fails closed. Secret key: Cloudflare dashboard > Turnstile.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames the widget may report; add localhost to try the real widget locally.
TURNSTILE_ALLOWED_HOSTNAMES=finale-ziro-h79s.onrender.com

# Optional: require "Authorization: Bearer <value>" on GET /metrics. Empty leaves /metrics open; set it before deploying.
METRICS_TOKEN=
