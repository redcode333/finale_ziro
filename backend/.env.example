SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Set to any long random string to enable POST /teams/{id}/seed (sent as X-Admin-Token)
SEED_ADMIN_TOKEN=

# Optional: require "Authorization: Bearer <value>" on GET /metrics. Empty leaves /metrics open; set it before deploying.
METRICS_TOKEN=

# Gemini model. The default is gemini-3.5-flash-lite (gemini-2.5-flash is retired for new keys and returns HTTP 404).
# GEMINI_MODEL=gemini-3.5-flash-lite
