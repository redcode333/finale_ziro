# Mock layer (demo data, also used for features the backend does not have yet).
VITE_USE_MOCKS=true
VITE_API_BASE_URL=

# Live backend (FastAPI). Leave empty to disable the mentor-token sign-in.
VITE_LIVE_API_URL=http://localhost:8000
VITE_LIVE_TEAM_ID=team_fs_001
VITE_LIVE_PROJECT_ID=proj_fs_001

# Public values only. Never put provider secrets or the mentor token in Vite variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
